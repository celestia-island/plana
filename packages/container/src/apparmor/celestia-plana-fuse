# celestia-plana-fuse — named AppArmor profile for scepter/cosmos containers.
#
# Mirrors Docker's built-in `docker-default` baseline and additionally permits
# FUSE mounts, which `fuse-overlayfs` requires to isolate cosmos sub-container
# root filesystems. docker-default denies `mount fstype=fuse.*`, which is why
# these containers previously ran with `apparmor=unconfined`.
#
# Install and load on the Docker host (as root) before use:
#   install -m 0644 celestia-plana-fuse /etc/apparmor.d/celestia-plana-fuse
#   apparmor_parser -r /etc/apparmor.d/celestia-plana-fuse
#
# If this profile is not loaded, Docker rejects container creation with a clear
# error — the intended fail-closed path (no runtime detection is performed).

#include <tunables/global>

profile celestia-plana-fuse flags=(attach_disconnected,mediate_deleted) {

  #include <abstractions/base>

  # ---- Core grants inherited from docker-default ----
  network,
  capability,
  file,
  umount,
  pivot_root,

  # Allow signalling and tracing between container processes (docker-default).
  signal (receive) peer=unconfined,
  signal (send,receive) peer=celestia-plana-fuse,
  ptrace (trace,read,tracedby,readby) peer=celestia-plana-fuse,

  # Harden /proc and /sys like docker-default.
  deny /proc/[0-9]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # ---- Mount rules: docker-default baseline plus FUSE ----
  mount options=(ro, remount) -> /,
  mount options=(ro, remount, strictatime, noatime, nodiratime, relatime) -> /proc/,
  mount options=(ro, remount, strictatime, noatime, nodiratime, relatime) -> /sys/,
  mount options=(ro, nosuid, noexec, remount, strictatime, noatime, nodiratime, relatime) -> /sys/fs/cgroup/,
  mount options=(ro, nosuid, nodev, noexec, remount, strictatime, noatime, nodiratime, relatime) -> /dev/,
  mount fstype=devpts,
  mount options=(rw, nosuid, noexec, remount, strictatime, noatime, nodiratime, relatime) -> /dev/pts/,
  mount options=(ro, nosuid, noexec, remount, noatime, relatime, strictatime) -> /dev/mqueue/,
  mount fstype=proc,
  mount fstype=sysfs,
  mount fstype=cgroup -> /sys/fs/cgroup/**,
  mount fstype=overlay,

  # FUSE mounts (fuse-overlayfs) — the reason this named profile exists.
  # The kernel reports FUSE filesystem types as `fuse.<subtype>` (e.g.
  # `fuse.fuse-overlayfs`), so the `fuse.*` glob covers every FUSE backend.
  mount fstype=fuse.*,
  mount fstype=fuse.fuse-overlayfs,

  # ---- Deny mounts docker-default rejects ----
  deny mount fstype=debugfs,
  deny mount fstype=securityfs,
  deny mount fstype=pstore,
  deny mount fstype=efivarfs,
}
